# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://localhost:27017/agoge

# Admin panel (/admin) — both are required for admin login to work.
# Generate the bcrypt hash with: node scripts/hash-password.js "your-password"
ADMIN_PASSWORD_HASH=
# Any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
